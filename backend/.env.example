# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Production frontend URL for CORS allow-list (set to your Vercel URL)
FRONTEND_URL=https://your-app.vercel.app

# Optional: Gemini AI API key for LLM agent features
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Affinda API key for resume parsing
AFFINDA_API_KEY=your-affinda-api-key-here
AFFINDA_WORKSPACE_ID=your-affinda-workspace-id-here
